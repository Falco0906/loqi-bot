# Loqi backend environment configuration (PR10.2 validated at startup).
#
# The application validates configuration on startup and fails fast with
# non-secret, key-only errors. Copy this file to .env and fill in real values.
# NEVER commit .env. Placeholders below are documentation only.

# ── Environment indicator ──────────────────────────────────────────────────
# ENVIRONMENT (or APP_ENV) selects the validation profile.
#   development  -> required config is optional-with-warning; dev/test flags
#                   (SIMULATE_REPLIES, LOQI_ENABLE_TEST_RECIPIENT_OVERRIDE,
#                   BILLING_PROVIDER_MODE=mock) are allowed.
#   production   -> required config must be present; dev/test flags are
#                   rejected; unsafe combinations fail startup.
ENVIRONMENT=development
# APP_ENV=development

# ── Required in production (startup fails if missing) ──────────────────────
# In development these are optional-with-warning (features degrade).
SUPABASE_URL=https://your-project.supabase.co
# PR10.8.3.3: this MUST be the Supabase service_role key. The backend uses it
# for all persistence (RLS is bypassed by service_role), so tenant isolation
# is enforced at the application layer. Never expose this key to any client;
# the frontend talks only to the FastAPI backend.
SUPABASE_KEY=your_supabase_key_here
OPENAI_API_KEY=sk-your_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Optional integrations ──────────────────────────────────────────────────
# Lead provider (supported: synthetic | apollo). Default is synthetic.
LEAD_PROVIDER=synthetic
APOLLO_API_KEY=your_apollo_key_here
SERPAPI_API_KEY=your_serpapi_key_here
ENRICHMENT_PROVIDER=
HUNTER_API_KEY=
PEOPLE_DATA_LABS_API_KEY=

# Email provider (supported: console | resend). resend requires RESEND_API_KEY
# in production.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Telegram bot token (optional).
BOT_TOKEN=your_bot_token_here

# Google OAuth redirect (used by the Gmail connect flow).
GOOGLE_REDIRECT_URI=http://127.0.0.1:10000/google/callback

# ── Frontend / CORS ────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Server / runtime ───────────────────────────────────────────────────────
# Validated: PORT must be 1-65535; INBOX_SYNC_INTERVAL_SECONDS must be > 0.
PORT=10000
INBOX_SYNC_INTERVAL_SECONDS=120

# ── Logging (PR10.4) ────────────────────────────────────────────────────────
# Validated: LOG_LEVEL in DEBUG|INFO|WARNING|ERROR|CRITICAL; LOG_FORMAT in
# text|json. DEBUG is rejected when ENVIRONMENT=production.
# Production default: INFO + json. Development default: INFO + text.
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Credential encryption at rest (PR10.7) ─────────────────────────────────
# AES-256-GCM key for encrypting persisted OAuth tokens (connected_accounts).
# Must be exactly 64 hex characters (32 random bytes). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (startup fails without it). In development it is
# optional; without it credentials are stored plaintext (dev-only).
LOQI_CREDENTIAL_ENCRYPTION_KEY=
# Optional previous key for rotation (same 64-hex format).
LOQI_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# Path to the JSON conversation-state file (persisted between restarts).
# Containerized deployments mount a volume and point this to it.
CONVERSATIONS_STATE_FILE=

# Path to the communication-store JSON file (sync cursor, seen-message set,
# thread mappings). Durable so a container restart resumes incremental sync
# instead of re-syncing from scratch. Mount the same volume as above.
COMMUNICATION_STATE_FILE=

# ── Development-only (REJECTED when ENVIRONMENT=production) ─────────────────
SIMULATE_REPLIES=false
SIMULATE_ACCELERATED=false
SIMULATE_REPLY_MULTIPLIER=1.0
SIMULATE_REPLY_WEIGHTS=

# ── Telegram webhook authentication (PR10.8.3) ──────────────────────────────
# Shared secret used to authenticate /webhook calls from Telegram. Must match
# the secret_token passed to Telegram's setWebhook. REQUIRED in production
# when TELEGRAM_BOT_TOKEN is set; without it the webhook is unauthenticated.
TELEGRAM_WEBHOOK_SECRET=

# Development/test-only recipient override. When true, Draft Review and the
# Inbox reply flow can route an approved outbound envelope to a controlled test
# recipient. Disabled by default; never enabled in production.
LOQI_ENABLE_TEST_RECIPIENT_OVERRIDE=false

# Billing mode (supported: mock | stripe). mock is rejected in production.
BILLING_PROVIDER_MODE=mock

# ── Rate limiting (PR10.5) ─────────────────────────────────────────────────
# In-process fixed-window limiter (per-instance). Enabled by default in
# production; disabled by default in development. Must NOT be disabled in
# production (validated). Positive integers, requests per 60s window.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_OUTBOUND_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# ── Lifecycle (PR10.6) ─────────────────────────────────────────────────────
# Bounded graceful-shutdown timeout for background workers (seconds).
SHUTDOWN_TIMEOUT_SECONDS=5
