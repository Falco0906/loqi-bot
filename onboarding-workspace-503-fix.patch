diff --git a/backend/main.py b/backend/main.py
index 788d8fd..d7bf9a6 100644
--- a/backend/main.py
+++ b/backend/main.py
@@ -192,10 +192,31 @@ from services.onboarding.repositories import InMemoryLifecycleRepository, InMemo
 _onboarding_lifecycle_repo = InMemoryLifecycleRepository()
 _onboarding_session_repo = InMemoryOnboardingSessionRepository()
 _onboarding_lifecycle_svc = LifecycleService(_onboarding_lifecycle_repo)
+
+# Onboarding's create_workspace_and_finalize() creates/reuses an organization
+# through this org_service, then immediately calls ensure_workspace() and
+# workspaces_for_user() — both of which are hardcoded to Supabase with no
+# REPOSITORY_PROVIDER branching. _org_deps.org_service follows the global
+# REPOSITORY_PROVIDER switch (in-memory by default outside production), so
+# onboarding could create an organization that Supabase's own membership
+# check then can never find, failing with "Workspace creation could not be
+# confirmed". Onboarding's org_service is therefore always Supabase-backed,
+# matching the workspace step it feeds into, regardless of the global
+# REPOSITORY_PROVIDER setting (which still governs other org/membership
+# features such as the organization management API).
+from services.organizations.services import OrganizationService as _OrganizationServiceCls
+from services.persistence.repositories import (
+    SupabaseMembershipRepository as _SupabaseMembershipRepository,
+    SupabaseOrganizationRepository as _SupabaseOrganizationRepository,
+)
+_onboarding_org_svc = _OrganizationServiceCls(
+    _SupabaseOrganizationRepository(), _SupabaseMembershipRepository(),
+)
+
 _onboarding_svc = OnboardingServiceCls(
     lifecycle_service=_onboarding_lifecycle_svc,
     session_repo=_onboarding_session_repo,
-    org_service=_org_deps.org_service,
+    org_service=_onboarding_org_svc,
     user_service=get_auth_user_service(),
 )
 set_onboarding_service(_onboarding_svc)
