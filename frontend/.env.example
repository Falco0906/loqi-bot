# Loqi frontend environment configuration.
#
# NEXT_PUBLIC_* variables are INLINED AT BUILD TIME by Next.js. They are NOT
# runtime secrets — never put private credentials in a NEXT_PUBLIC_ variable
# (they become visible in the browser bundle).

# Backend base URL used by the browser for API calls.
#   local dev:  http://127.0.0.1:10000
#   Docker:     http://backend:10000  (set as the Docker build ARG)
NEXT_PUBLIC_LOQI_API_BASE_URL=http://127.0.0.1:10000

# Development-only UI affordances (e.g. test-recipient override input).
# Set to true only in local development; never in production.
NEXT_PUBLIC_DEV_MODE=false
