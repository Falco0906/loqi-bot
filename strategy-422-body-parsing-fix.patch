+    body = _parse_optional_json_body(await request.body())
     return await service.start_strategy_generation(
         bearer_token,
         owner_id,
         workspace_id,
         campaign_id,
-        force=bool(payload and payload.force),
+        force=bool(body.get("force", False)),
     )
 
 
